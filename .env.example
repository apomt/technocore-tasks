TASKS_SIGNING_ROOM=technocore-tasks
TASKS_COLLECTOR_ENABLED=1
TECHNOCORE_BASE_URL=https://technocore.chat
PORT=8800
# Local CLI only. Never configure this on a hosted service.
# SIGN_SEED=<32-byte hex or unpadded base64url seed>
